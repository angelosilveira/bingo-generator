rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Apenas usuários autenticados podem ler/escrever
    match /bingos/{docId} {
      allow read, write: if request.auth != null;
    }
    // Config do template (salvar template customizado)
    match /config/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
